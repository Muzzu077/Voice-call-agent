# ── AI Voice Planner Agent ─────────────────────────
#
# For local emulation, standard demo configs are automatically injected.
# In production, create:
#   1. frontend/.env.local (for client Next.js config)
#   2. functions/.env (for serverless python configuration)

# ── Frontend Configuration (frontend/.env.local) ──
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ── Backend Configuration (functions/.env) ────────
GCLOUD_PROJECT=your-project-id
BASE_URL=https://us-central1-your-project-id.cloudfunctions.net

# Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=your-twilio-sip-or-phone-number
TWILIO_SIP_DOMAIN=your-sip-domain.sip.twilio.com
TWILIO_CREDENTIAL_LIST_SID=your-credential-list-sid

# LLM / AI Configuration
LLM_API_KEY=your-openai-api-key
OPENAI_TASK_MODEL=gpt-4o
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional: OpenRouter Configuration
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=VoiceCallAgent
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
