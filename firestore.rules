rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId 
                            && request.resource.data.timezone is string
                            && request.resource.data.morning_call_time is string;
      
      match /tasks/{taskId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_completed'])
                      && request.resource.data.is_completed is bool;
        allow create, delete: if false;
      }

      match /call_logs/{logId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /sip_credentials/{credId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }
  }
}
